APP_ENV=QA
APP_SECRET_KEY=CAMBIAR_EN_ENV_REAL
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=False
APP_VERSION=1.0.0
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_TTL_SEGUNDOS=3600
LOG_LEVEL=INFO

DB_SERVER=SERVIDOR_O_INSTANCIA
DB_DATABASE=APP_SCHEDULER_QA
DB_USER=USUARIO_SQL
DB_PASSWORD=PASSWORD_SQL_ESCAPADA_PARA_DOCKER
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=10
DB_APPLICATION_NAME=APP_SCHEDULER

USUARIO_ADMIN_DEFECTO=admin_qa
PASSWORD_ADMIN_DEFECTO=CAMBIAR_EN_ENV_REAL

RUTA_BASE_SCRIPTS=scripts
RUTA_BASE_ENV_SCRIPTS=env_scripts
RUTA_BASE_LOGS_TAREAS=logs_tareas
RUTA_BASE_LOGS_SISTEMA=logs_sistema
RUTA_BASE_LOGS_WORKER=logs
RUTA_CONTROL_RUNTIME=/app/runtime_control
FACTORY_RESET_LOCK_TIMEOUT_SEGUNDOS=1800
FACTORY_RESET_PREVIEW_TTL_SEGUNDOS=300
FACTORY_RESET_CSRF_TTL_SEGUNDOS=600
FACTORY_RESET_HABILITADO=false
FACTORY_RESET_DB_TARGET=
FACTORY_RESET_DB_ALLOWED_TARGETS=
FACTORY_RESET_DB_SERVER=
FACTORY_RESET_DB_USER=
FACTORY_RESET_DB_PASSWORD=
FACTORY_RESET_DB_ENCRYPT=no
FACTORY_RESET_DB_TRUST_SERVER_CERTIFICATE=yes
FACTORY_RESET_SQLCMD=sqlcmd
FACTORY_RESET_SQLCMD_TIMEOUT_SEGUNDOS=900
FACTORY_RESET_APP_NAME_PREFIX=APP_SCHEDULER
MAX_SCRIPT_SIZE_MB=5
MAX_ENV_SIZE_KB=100
EJECUCION_TIMEOUT_SEGUNDOS=3600
EJECUCION_GRACIA_TERMINACION_SEGUNDOS=5
ZONA_HORARIA=America/Santiago

GRAPH_CLIENT_SECRET=
GRAPH_SECRET_CONFIG_MODE=ENV
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_SEND_MAIL_USER=
GRAPH_MAIL_ENABLED=false
GRAPH_SAVE_TO_SENT_ITEMS=true
GRAPH_ALERTAS_DEFAULT=alertas@example.com
